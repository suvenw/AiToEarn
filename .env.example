# AiToEarn 内网部署环境变量样例
# 复制为 .env 后填入实际值：cp .env.example .env

# === 必填：JWT 签名密钥（必须 32 字节以上，与 init.mjs 中使用的密钥保持一致） ===
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-random-48-byte-hex-string

# === 必填：服务间内部令牌 ===
INTERNAL_TOKEN=replace-me-with-another-random-string

# === 可选：内网主机名（默认 aitoearn.local） ===
INTERNAL_HOST=aitoearn.local
INTERNAL_SCHEME=http

# === 可选：自动登录开关（默认 0 = 关闭，需要 docker compose 注入 AUTO_LOGIN_TOKEN 才生效） ===
AUTO_LOGIN_ENABLED=0
